# For local Compose only. Use URL-safe letters and digits in this password.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional active database after recovery. The restored database must already exist.
# BHARATOS_DATABASE=bharatos_restore_test
# Optional restricted web connection. Provision the role and grants before enabling.
# WEB_DATABASE_URL=postgresql+psycopg://bharatos_web:YOUR_WEB_PASSWORD@db:5432/${BHARATOS_DATABASE:-bharatos}
# Optional: at least 32 characters; use a separate random value.
ADMIN_TOKEN=
# Optional local HTTP and HTTPS listener ports.
# WEB_HTTP_PORT=8000
# TLS_PORT=8443
# Optional source-monitor profile; minimum 300 seconds.
# SOURCE_CHECK_INTERVAL_SECONDS=3600
# Optional ingestion profile: explicitly supply a verified local snapshot and its checksum.
# PIN_SNAPSHOT_PATH=./data/approved-pincode.csv
# PIN_VERIFIED_ON=YYYY-MM-DD
# PIN_SNAPSHOT_SHA256=lowercase-sha256-digest
# PIN_IMPORT_INTERVAL_SECONDS=3600
